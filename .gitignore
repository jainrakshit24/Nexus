__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
venv/

# A project's own memory index is a rebuildable cache, never committed.
.nexus/index.db
.nexus/index.db-*

# graphify build output — generated, not source
graphify-out/

# NEXUS working data for this repo itself (dogfooding), not source.
# The secret allowlist is policy, not working data, so it stays committed —
# otherwise a fresh clone blocks on this repo's own test fixtures.
.nexus/*
!.nexus/secret-allowlist

# Serena language-server cache and local project config — generated
.serena/

# Host wiring written by `nexus install`. These carry absolute paths from the
# machine that generated them, so they are local setup, not source. Anyone
# cloning runs `nexus install <host>` and gets their own.
.mcp.json
.claude/settings.json
.claude/settings.local.json

# Skills installed locally by `npx skills add` — not source
.agents/
skills-lock.json
